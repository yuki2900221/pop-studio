{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pop-studio-yamadaya",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  // Production requires Worker-level Cloudflare Access: /api/* verifies the
  // Access JWT against this team domain and application AUD (public values).
  // Override with ACCESS_REQUIRED=false in .dev.vars for local `wrangler dev`.
  "vars": {
    "ACCESS_REQUIRED": "true",
    "ACCESS_TEAM_DOMAIN": "https://young-wildflower-2a69.cloudflareaccess.com",
    "ACCESS_AUD": "4ba4eca85e33cbdbd366c1603a7b1208cd09c47a0fece43c0038e50b32b1a68c",
  },
}
